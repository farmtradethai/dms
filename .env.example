# ---- Die Management System ----
APP_NAME=Die Management System
SECRET_KEY=change-this-to-a-long-random-string
BASE_URL=http://localhost:8790
PORT=8790
TZ_OFFSET_HOURS=7

# empty = SQLite file in ./data (fine for 1 factory, local server / Cloudflare Tunnel)
# free Postgres (Neon / Supabase) for Render-style hosts whose disk is not persistent:
DATABASE_URL=
# DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# image policy
IMAGE_MAX_SIDE=1600
IMAGE_QUALITY=78
MAX_UPLOAD_MB=12
STORAGE_WARN_MB=400

# optional: S3-compatible image store (Cloudflare R2 free 10GB / Supabase Storage 1GB)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
S3_REGION=auto
